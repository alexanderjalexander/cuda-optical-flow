#!/usr/bin/env bash

# If any of these invocations return a non-zero exit code
# OR if you expand an unset variable, stop.
set -euo pipefail

# Glob expansions (.../*) that match to nothing expand to nothing.
shopt -s nullglob



# == Helpers ==================================================================
log_header()  { echo; echo ">>> $*"; }
log()  { echo "[INFO]: $*"; }
warn()  { echo "[WARN]: $*"; }
die()  { echo "[FATAL]: $*" >&2; exit 1; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

CLEAN_BUILD=0

for arg in "$@"; do
    case "$arg" in
        --clean-build)
            CLEAN_BUILD=1
            ;;
        -h|--help)
            echo "Usage: $0 [--clean-build]"
            exit 0
            ;;
        *)
            die "Unknown option: ${arg}. Usage: $0 [--clean-build]"
            ;;
    esac
done



# == Operating System Check ===================================================
. /etc/os-release
log_header "Performing OS check..."
[[ "${ID:-}" == fedora ]] || die "This script requires Fedora."
FEDORA_VER="$(rpm -E '%fedora')"
[[ "$FEDORA_VER" == 45 ]] || die "Requires Fedora 45; detected ${FEDORA_VER}."

log "OS verified. Continuing..."

# Locking the version number, this is a known-good one that works well, and contains up to date versions.
CUDA_FEDORA_VER=44



# == RPM Fusion Free & Nonfree (provides ffmpeg, NVIDIA drivers, etc.) ========
RPM_FUSION_FREE_URL="https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-${FEDORA_VER}.noarch.rpm"
RPM_FUSION_NONFREE_URL=""https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${FEDORA_VER}.noarch.rpm""

log_header "Adding RPM Fusion Free repository..."
if ! dnf repolist --enabled 2>/dev/null | grep -qi "rpmfusion-free"; then
    sudo dnf install -y "${RPM_FUSION_FREE_URL}" || die "Could not install RPM Fusion Free Repository. Exiting."
    log "RPM Fusion Free Repository installed."
else
    log "RPM Fusion Free Repository already present, skipping installation."
fi

log_header "Adding RPM Fusion Nonfree repository..."
if ! dnf repolist --enabled 2>/dev/null | grep -qi "rpmfusion-nonfree"; then
    sudo dnf install -y "${RPM_FUSION_NONFREE_URL}" || die "Could not install RPM Fusion Nonfree Repository. Exiting."
    log "RPM Fusion Nonfree Repository installed."
else
    log "RPM Fusion Nonfree Repository already present, skipping installation."
fi



# == CUDA repository ==========================================================
# NOTE: NVIDIA publishes a native Fedora 44 CUDA repo, which is optimal for.
#   Fedora 45. A test was verified at:
#   https://computingforgeeks.com/install-cuda-toolkit-fedora/
# Confirmed present at:
#   https://developer.download.nvidia.com/compute/cuda/repos/fedora44/x86_64/
log_header "Performing CUDA Repository Check..."

CUDA_REPO_ID="cuda-fedora${CUDA_FEDORA_VER}-x86_64"
CUDA_REPO_URL="https://developer.download.nvidia.com/compute/cuda/repos/fedora${CUDA_FEDORA_VER}/x86_64/cuda-fedora${CUDA_FEDORA_VER}.repo"

CUDA_REPOS="$(dnf repolist --all 2>/dev/null)" || die "Could not list DNF repositories."
if ! grep -Fq "${CUDA_REPO_ID}" <<< "${CUDA_REPOS}"; then
    log "Adding NVIDIA CUDA repository for Fedora ${CUDA_FEDORA_VER}..."
    sudo dnf config-manager addrepo --from-repofile "${CUDA_REPO_URL}"
else
    log "NVIDIA CUDA repository is already configured."
fi

REPO_OPTS="${CUDA_REPO_ID}.exclude="
REPO_OPTS+="nvidia-driver*,cuda-drivers*,nvidia-modprobe,nvidia-persistenced,"
REPO_OPTS+="nvidia-settings,nvidia-libXNVCtrl*,nvidia-xconfig,nvidia-open,nvidia-imex,"
REPO_OPTS+="nvidia-kmod-common,libnvidia-fbc,kmod-nvidia-*-dkms,"
REPO_OPTS+="nvidia-fs*,nvidia-gds*,xorg-x11-nvidia*"

log "Ensuring NVIDIA CUDA repository is enabled..."
sudo dnf config-manager setopt "${CUDA_REPO_ID}.enabled=1"
sudo dnf config-manager setopt "${REPO_OPTS}"



# == DNF Cache Clean & Make ===================================================
sudo dnf clean all
sudo dnf makecache || die "dnf makecache failed after configuring CUDA repo"



# == CUDA Toolkit Installation ================================================
log_header "Checking for nvcc..."
if ! command -v nvcc >/dev/null; then
    log "nvcc not present. Installing CUDA Toolkit..."
    sudo dnf install -y cuda-toolkit
    command -v nvcc >/dev/null || die "CUDA Toolkit installation did not provide nvcc."
    log "CUDA Toolkit installed."
else
    log "nvcc present. Skipping CUDA Toolkit installation."
fi


# == NVIDIA Drivers ===========================================================
log_header "Checking to see if NVIDIA drivers are already installed..."
if ! which nvidia-smi >/dev/null; then
    log "NVIDIA drivers not installed."

    sudo dnf install -y akmod-nvidia xorg-x11-drv-nvidia-cuda

    die "Driver packages installed. Reboot, verify nvidia-smi, then rerun this script. Please reboot system before continuing with the rest of the script."
else
    log "NVIDIA drivers already present."
fi



# == Install build dependencies ==============================================
# Fedora package equivalents:
#   python3-dev          -> python3-devel
#   build-essential      -> gcc-c++ make
#   libgtk-3-dev         -> gtk3-devel
#   libpng-dev           -> libpng-devel
#   libjpeg-dev          -> libjpeg-turbo-devel
#   libavcodec/format/
#     util/swscale/
#     device-dev         -> ffmpeg-devel  (single package on Fedora/RPM Fusion)
#
# NVENC / NVDEC headers (nvcuvid.h, nvEncodeAPI.h) ship inside the CUDA
# toolkit under /usr/local/cuda/include/ - pulled in by cuda-toolkit below.
log_header "Installing dependencies..."
sudo dnf install -y \
    python3-devel \
    python3-numpy \
    cmake \
    ninja-build \
    gcc \
    gcc-c++ \
    make \
    gtk3-devel \
    libpng-devel \
    libjpeg-turbo-devel

# FFmpeg must be installed separately with --allowerasing.
# Fedora 41+ ships its own codec-stripped split packages
# (libswscale-free, libswresample-free, libpostproc-free, ...) that conflict
# with RPM Fusion's unified ffmpeg-libs. --allowerasing lets DNF replace
# those *-free stubs with RPM Fusion's full build, which is a strict superset.
log_header "Installing ffmpeg (replacing Fedora *-free stubs with RPM Fusion build)..."
sudo dnf install -y --allowerasing \
    ffmpeg \
    ffmpeg-devel \
    ffmpeg-libs



# == Verify NVENC / NVDEC headers ============================================
log_header "Checking for Video Codec SDK headers..."
MISSING_HEADERS=()
for HDR in nvcuvid.h cuviddec.h nvEncodeAPI.h; do
    if [[ ! -f "/usr/local/cuda/include/${HDR}" ]]; then
        MISSING_HEADERS+=("${HDR}")
    fi
done

if [[ ${#MISSING_HEADERS[@]} -gt 0 ]]; then
    log "WARNING: The following headers were not found under /usr/local/cuda/include:"
    for HDR in "${MISSING_HEADERS[@]}"; do
        log "  - ${HDR}"
    done
    log "Download the NVIDIA Video Codec SDK from:"
    log "  https://developer.nvidia.com/nvidia-video-codec-sdk"
    log "and copy the Interface/ headers to /usr/local/cuda/include/ before continuing."
    die "Missing NVENC/NVDEC headers. See instructions above."
else
    log "All NVENC/NVDEC headers found."
fi



# == Cloning OpenCV & OpenCV Contrib ========================================
cd "${SCRIPT_DIR}"

ensure_repo() {
    local dir="$1" url="$2"

    if (( CLEAN_BUILD )); then
        log "Clean build enabled. Removing existing '${dir}' repo..."
        rm -rf "${dir}"
        log "Recloning '${dir}' repo..."
        git clone "${url}" "${dir}" || die "Could not clone ${url}."
        return
    fi

    if [[ -d "${dir}/.git" ]]; then
        log "Using existing checkout: ${dir}"
        cd "${dir}"
        git pull
        cd "${SCRIPT_DIR}"
        log "Latest changes pulled."
    elif [[ -e "${dir}" ]]; then
        die "${dir} exists but is not a Git checkout; inspect it before proceeding."
    else
        git clone "${url}" "${dir}" || die "Could not clone ${url}."
    fi
}

log_header "Preparing OpenCV & OpenCV Contrib..."

ensure_repo "${SCRIPT_DIR}/opencv" \
    "https://github.com/opencv/opencv.git"
ensure_repo "${SCRIPT_DIR}/opencv_contrib" \
    "https://github.com/opencv/opencv_contrib.git"

if (( CLEAN_BUILD )); then
    log "Clean build enabled. Removing existing OpenCV build directory..."
    rm -rf -- "${SCRIPT_DIR}/opencv_build"
fi

mkdir -p "${SCRIPT_DIR}/opencv_build"



# == CMake configure ==========================================================
log_header "Configuring OpenCV..."
cd "${SCRIPT_DIR}/opencv_build"

# See that HARFBUZZ line? Yeah, basically the ones that are included with
#   Fedora 45 don't really... mesh well with this? Essentially, we jsut bundle
#   in the OpenCV Harfbuzz so that this compiles properly.
cmake \
    -GNinja \
    -DWITH_CUDA=ON \
    -DWITH_CUDNN=OFF \
    -DOPENCV_DNN_CUDA=OFF \
    -DCUDA_ARCH_BIN="7.5" \
    -DWITH_CUBLAS=ON \
    -DWITH_NVCUVID=ON \
    -DWITH_NVCUVENC=ON \
    -DWITH_FFMPEG=ON \
    -DBUILD_HARFBUZZ=ON \
    -DOPENCV_EXTRA_MODULES_PATH="${SCRIPT_DIR}/opencv_contrib/modules" \
    -DBUILD_opencv_legacy=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    "${SCRIPT_DIR}/opencv"

# Confirm the summary lines we care about before committing to a long build.
# cmake writes the summary to CMakeCache.txt; grep it there so we don't have
# to re-parse stdout after the fact.
check_cmake_flag() {
    local label="$1" pattern="$2" expected="$3"
    local actual
    actual="$(grep -i "${pattern}" CMakeCache.txt | head -1 | cut -d= -f2 | tr -d '[:space:]')"
    if [[ "${actual^^}" != "${expected^^}" ]]; then
        die "CMake flag check failed: ${label} - expected '${expected}', got '${actual}'"
    fi
    log "  OK  ${label}: ${actual}"
}

log "Verifying CMake configuration summary..."
# These map to well-known CMakeCache keys; adjust if upstream renames them.
check_cmake_flag "WITH_CUDA"    "WITH_CUDA:BOOL"    "ON"
check_cmake_flag "WITH_FFMPEG"  "WITH_FFMPEG:BOOL"  "ON"
check_cmake_flag "WITH_CUBLAS"  "WITH_CUBLAS:BOOL"  "ON"
check_cmake_flag "WITH_NVCUVID" "WITH_NVCUVID:BOOL" "ON"



# == Build ====================================================================
log_header "Building (this will take a while)..."
ninja -j"$(nproc)"



# == Install ==================================================================
log_header "Installing..."
sudo ninja install



# == ldconfig drop-in for /usr/local/lib64 ====================================
# On Fedora (and all RPM-based distros), `make install` / `ninja install`
# targets a lib64/ directory when building 64-bit. /usr/local/lib64 is not
# in the default ldconfig search path, so we register it explicitly.
LDCONF_FILE="/etc/ld.so.conf.d/opencv.conf"
log_header "Writing ldconfig drop-in -> ${LDCONF_FILE}"

sudo tee "${LDCONF_FILE}" > /dev/null <<'EOF'
# Added by build_opencv_fedora
# Required because OpenCV installs into /usr/local/lib64 on Fedora,
# which is not searched by default.
/usr/local/lib64
EOF

sudo ldconfig
log "ldconfig updated."



# == Sanity check =============================================================
log_header "Running sanity check..."
python3 - <<'PYEOF'
import cv2
count = cv2.cuda.getCudaEnabledDeviceCount()
print(f"CUDA-enabled devices visible to OpenCV: {count}")
if count == 0:
    raise SystemExit("No CUDA devices found - check driver and CUDA installation.")
build_info = cv2.getBuildInformation()
for keyword in ("CUDA", "NVCUVID", "NVCUVENC", "FFmpeg"):
    for line in build_info.splitlines():
        if keyword in line:
            print(line.strip())
            break
PYEOF



# == Finale ===================================================================
log_header "Done. All dependencies successfully installed."
